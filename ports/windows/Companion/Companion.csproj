<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>Cliphoard.Companion</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Cliphoard.Windows/BoundedCommandLines.cs" Link="BoundedCommandLines.cs" />
    <Compile Include="../Cliphoard.Windows/OwnedProcessJob.cs" Link="OwnedProcessJob.cs" />
  </ItemGroup>
</Project>
