<Window x:Class="Cliphoard.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cliphoard · synthetic fixture">
 <Grid x:Name="Root" Padding="16" RowSpacing="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="8">
   <TextBlock Text="Cliphoard · synthetic only" VerticalAlignment="Center"/>
   <Button Content="Seed fixture" Click="OnSeed"/>
   <Button Content="Capture marked clipboard fixture" Click="OnClipboardFixture"/>
   <Button Content="Clear fixture" Click="OnClear"/>
   <Button Content="Lock &amp; purge" Click="OnLock"/>
   <Button Content="Paste selected" Click="OnPasteSelected"/>
  </StackPanel>
  <TextBox x:Name="Query" Grid.Row="1" PlaceholderText="Search synthetic text" MaxLength="256" TextChanged="OnSearch"/>
  <ListView x:Name="History" Grid.Row="2" IsItemClickEnabled="True" ItemClick="OnSelect"/>
  <TextBlock x:Name="Status" Grid.Row="3" Text="No real clipboard content is captured. Ctrl+Alt+Shift+B (VM alternative) or Ctrl+Alt+Shift+V opens this fixture; Esc returns focus." TextWrapping="Wrap"/>
 </Grid>
</Window>
